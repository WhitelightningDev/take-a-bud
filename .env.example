# Copy this file to `.env.local` and fill in your Supabase project values.
#
# Supabase settings (client-safe)
VITE_SUPABASE_URL="https://YOUR_PROJECT_REF.supabase.co"
VITE_SUPABASE_ANON_KEY="YOUR_SUPABASE_ANON_KEY"

# If you already have this key name in your env, it also works (same value as anon key):
# VITE_SUPABASE_PUBLISHABLE_KEY="YOUR_SUPABASE_ANON_KEY"

# Server-side / scripts only (NEVER expose in the browser)
SUPABASE_SERVICE_ROLE_KEY="YOUR_SUPABASE_SERVICE_ROLE_KEY"

# Optional helpers for `npm run seed:admin`
# ADMIN_SEED_EMAIL="admin@example.com"
# ADMIN_SEED_PASSWORD="use-a-strong-password"
